{
  "name": "nekadarederdi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "dotnet build backend/NekadarEderdi.Api.csproj && npm run build -w frontend",
    "build:cloudflare": "npm run build -w frontend",
    "check": "npm audit --omit=dev && npm run check:worker && npm run build",
    "check:worker": "tsc -p worker/tsconfig.json --noEmit",
    "cf:dev": "npm run build:cloudflare && wrangler dev",
    "cf:deploy": "npm run build:cloudflare && wrangler deploy",
    "data:update": "node scripts/update-market-data.mjs",
    "dev:backend": "dotnet run --project backend/NekadarEderdi.Api.csproj --urls http://localhost:7400",
    "dev:frontend": "npm run dev -w frontend -- --port 7573",
    "preview:frontend": "npm run preview -w frontend -- --port 7180"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "wrangler": "^4.29.1"
  }
}
